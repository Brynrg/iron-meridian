{
  "name": "iron-meridian",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint:paths": "node scripts/check-relative-paths.mjs",
    "test:unit": "vitest run",
    "verify": "npm run typecheck && npm run lint:paths && npm run lint:sim && npm run test:unit",
    "test": "playwright test",
    "deploy:portal": "npm run build && node scripts/deploy-portal.mjs",
    "lint:sim": "node scripts/check-sim-purity.mjs"
  },
  "dependencies": {
    "speedrungames-sdk": "github:Brynrg/speedrungames-sdk#v0.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  }
}
